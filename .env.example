# PostgreSQL (servico do docker compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cristalux
POSTGRES_PORT=5433

# Conexao do pipeline (dono dos schemas) e do agente (somente leitura).
# Dentro do compose o host e "postgres"; fora dele, "localhost".
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/cristalux
AGENT_DB_PASSWORD=agent_ro_local
# Opcional: se vazia, e derivada da DATABASE_URL com o papel cristalux_agent_ro e a senha acima (usado no Railway).
AGENT_DATABASE_URL=postgresql://cristalux_agent_ro:agent_ro_local@localhost:5433/cristalux

# Senha de acesso ao app. Vazia = sem protecao (so para uso local). Em producao, defina sempre.
APP_PASSWORD=

# Gemini (free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# minimal | low | medium | high
GEMINI_THINKING_LEVEL=low
# Modelos de reserva, em ordem, quando a cota diaria do principal acaba
GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.6-flash,gemini-3.5-flash,gemini-flash-lite-latest

# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# development | production (separa os traces de teste dos de producao)
LANGFUSE_TRACING_ENVIRONMENT=development

# Caminhos
DATA_DIR=dados_raw
REPORTS_DIR=reports
CHROMA_PATH=chroma_db

# Streamlit / Railway
PORT=8501

# RAG: gemini | local. Vazio usa gemini se houver chave, senao local.
EMBEDDING_BACKEND=
RAG_K=5
# Vazio usa o threshold padrao do backend (calibrado na avaliacao).
RAG_THRESHOLD=
# 1 grava respostas do LLM em disco (util nas avaliacoes com free tier).
LLM_CACHE=0
